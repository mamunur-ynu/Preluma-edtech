# Same names as .streamlit/secrets.example.toml — handy for Docker / FastAPI / CI.
DATABASE_URL=sqlite:///data/preluma.db
PRELUMA_TEACHER_INVITE_CODE=
PRELUMA_ADMIN_USERS=
PRELUMA_ALLOW_LEGACY_BROWSER_SESSION=false
PRELUMA_AI_REQUESTS_PER_MINUTE=12
# SQLite demo: memory; PostgreSQL: database is mandatory.
PRELUMA_RATE_LIMIT_BACKEND=memory
# PostgreSQL chooses a shared database index automatically; SQLite demos default to local JSON.
# PRELUMA_VECTOR_STORE=database
# Required to permit live provider calls with PostgreSQL; global calls/hour, including failovers.
PRELUMA_PROVIDER_CALLS_PER_HOUR=
# Owner-supplied estimated daily USD budget and exact provider:model prices per million tokens.
# PostgreSQL live calls deny unless both are configured. Provider-side hard cap still required.
PRELUMA_PROVIDER_MAX_USD_PER_DAY=
PRELUMA_PROVIDER_PRICES_JSON=
PRELUMA_CONVERSATION_RETENTION_DAYS=30
# Required for PostgreSQL document uploads/recovery: one owner-managed Fernet key.
# SQLite demos create data/document_recovery.key (0600); back it up with the DB.
PRELUMA_DOCUMENT_KEY=
# Private FastAPI/Next.js connection only; use one random >=32-character value on both servers.
# Never use NEXT_PUBLIC_ for this secret. Keep the FastAPI port on a private network.
PRELUMA_BFF_SHARED_KEY=
PRELUMA_API_INTERNAL_URL=http://127.0.0.1:8765
# Exact browser origin (HTTPS outside local development); never derive it from Host/X-Forwarded-*.
PRELUMA_PUBLIC_ORIGIN=http://127.0.0.1:3000
# Independent random >=32-character HMAC key for session-bound CSRF proofs.
PRELUMA_CSRF_SECRET=
PRELUMA_LLM_TIMEOUT=20
PRELUMA_LLM_MAX_TOKENS=2200
GROQ_API_KEY=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
TOGETHER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
